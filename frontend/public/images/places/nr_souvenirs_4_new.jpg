  <script>
  (function(){
    var ls = document.createElement('div');
    ls.id = 'loadingScreen';
    var isDark = localStorage.getItem('museum-dark-mode') === 'true' ||
      (!localStorage.getItem('museum-dark-mode') && window.matchMedia('(prefers-color-scheme:dark)').matches);
    ls.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;background:'+(isDark?'#121212':'#F7F7F5')+';transition:opacity 0.5s ease,visibility 0.5s ease;';
    
    // Delay loading the animation to avoid flashing on fast loads and prevent AbortError
    window.loadingAnimationTimeout = setTimeout(function() {
      var screen = document.getElementById('loadingScreen');
      if (screen) {
        screen.innerHTML = '<dotlottie-wc src="https://www.museumthailand.com/images/004.svg.lottie" autoplay loop speed="1.8" style="width:180px;height:180px;"></dotlottie-wc>';
      }
    }, 150);

    document.currentScript.parentNode.insertBefore(ls, document.currentScript);
  })();
</script>



<script>
  (function() {
    var hidden = false;

    function hideLoadingScreen() {
      if (hidden) return;
      if (window.loadingAnimationTimeout) {
        clearTimeout(window.loadingAnimationTimeout);
      }
      var screen = document.getElementById('loadingScreen');
      if (!screen) return;
      hidden = true;
      screen.style.opacity = '0';
      screen.style.visibility = 'hidden';
      setTimeout(function () { screen.remove(); }, 500);
    }

    // Use DOMContentLoaded instead of window.load
    // DOMContentLoaded fires after HTML parsing — does NOT wait for
    // images, stylesheets, or module scripts from CDN
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        setTimeout(hideLoadingScreen, 300);
      });
    } else {
      // DOM already parsed (e.g. script ran late)
      setTimeout(hideLoadingScreen, 300);
    }

    // Livewire SPA navigation (wire:navigate) — DOMContentLoaded won't fire
    document.addEventListener('livewire:navigated', function () {
      setTimeout(hideLoadingScreen, 100);
    });

    // Safety net: never let loading screen stay more than 3s
    setTimeout(hideLoadingScreen, 3000);
  })();
</script>


