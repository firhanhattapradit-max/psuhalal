<style>
.v2-footer { padding:2rem 0; padding-bottom:calc(2rem + env(safe-area-inset-bottom, 0px)); }
.v2-footer__inner { display:flex;align-items:center;justify-content:space-between;max-width:1440px;margin:0 auto;padding:0 clamp(1rem,3vw,2.5rem);gap:clamp(1rem,2vw,2rem);flex-wrap:wrap; }
.v2-footer__logo { flex-shrink:0;display:flex;align-items:center;text-decoration:none; }
.v2-footer__logo-img { height:clamp(48px,4.5vw,60px);width:auto;object-fit:contain;opacity:.95;transition:opacity .3s ease; }
.v2-footer__logo:hover .v2-footer__logo-img { opacity:1; }
.v2-footer__social { display:flex;align-items:center;gap:clamp(12px,1.5vw,20px); }
.v2-footer__social-link { display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:12px;background:transparent;border:1px solid var(--card-border);transition:all .3s ease;text-decoration:none; }
.v2-footer__social-link svg { width:24px;height:24px; }

/* === Brand colors for each social icon === */
.v2-footer__social-link[data-brand="facebook"] { color:#1877F2; }
.v2-footer__social-link[data-brand="facebook"]:hover { border-color:#1877F2;background:rgba(24,119,242,.08);transform:translateY(-2px); }

.v2-footer__social-link[data-brand="x"] { color:#14171A; }
html.dark .v2-footer__social-link[data-brand="x"],
[data-theme="dark"] .v2-footer__social-link[data-brand="x"] { color:#E7E9EA; }
.v2-footer__social-link[data-brand="x"]:hover { border-color:#536471;background:rgba(83,100,113,.08);transform:translateY(-2px); }

.v2-footer__social-link[data-brand="line"] { color:#06C755; }
.v2-footer__social-link[data-brand="line"]:hover { border-color:#06C755;background:rgba(6,199,85,.08);transform:translateY(-2px); }

/* Instagram: gradient effect on the SVG icon */
.v2-footer__social-link[data-brand="instagram"] { color:#E4405F;position:relative; }
.v2-footer__social-link[data-brand="instagram"] svg { fill:url(#ig-gradient); }
.v2-footer__social-link[data-brand="instagram"]:hover { border-color:#E4405F;background:rgba(228,64,95,.08);transform:translateY(-2px); }

.v2-footer__copy { font-size:clamp(10px,0.7vw,12px);font-weight:500;color:var(--text-faint);letter-spacing:.5px;margin:0;white-space:nowrap; }
@media(max-width:640px){
  .v2-footer__inner {
    flex-direction:column !important;
    align-items:center !important;
    text-align:center !important;
    gap:1rem !important;
    padding-left: calc(1rem + env(safe-area-inset-left)) !important;
    padding-right: calc(1rem + env(safe-area-inset-right)) !important;
  }
  .v2-footer__logo { justify-content:center !important; }
  .v2-footer__social { justify-content:center !important; }
  .v2-footer__copy { text-align:center !important; white-space:normal !important; }
}
</style>
