<style>
  /* ═══ Popup Dialog Styles ═══ */
  .popup-dialog-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .popup-dialog-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .popup-dialog-overlay.popup-active .popup-dialog-backdrop {
    opacity: 1;
  }

  .popup-dialog-container {
    position: relative;
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--card-border, #e5e5e5);
    border-radius: 1.25rem;
    box-shadow: 0 25px 80px -12px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: scale(0.9) translateY(20px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ═══ Size Variants ═══ */
  .popup-dialog-container.popup-size-sm { max-width: 420px; }
  .popup-dialog-container.popup-size-md { max-width: 520px; }
  .popup-dialog-container.popup-size-lg { max-width: 680px; }
  .popup-dialog-container.popup-size-xl { max-width: 860px; }
  .popup-dialog-container.popup-size-full { max-width: 95vw; }

  .popup-dialog-overlay.popup-active .popup-dialog-container {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .popup-dialog-overlay.popup-closing .popup-dialog-backdrop {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .popup-dialog-overlay.popup-closing .popup-dialog-container {
    opacity: 0;
    transform: scale(0.95) translateY(10px);
    transition: opacity 0.25s ease,
                transform 0.25s ease;
  }

  /* Close button */
  .popup-dialog-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--card-border, #e5e5e5);
    background: var(--card-bg, #ffffff);
    color: var(--text-secondary, #525252);
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .popup-dialog-close:hover {
    background: var(--warm-tint-strong, #e8e8e5);
    transform: scale(1.1);
  }

  .popup-dialog-close:active {
    transform: scale(0.95);
  }

  /* Image */
  .popup-dialog-image-wrap {
    border-radius: 1.25rem 1.25rem 0 0;
    overflow: hidden;
    line-height: 0;
  }

  .popup-dialog-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .popup-dialog-image-wrap a:hover .popup-dialog-image {
    transform: scale(1.02);
  }

  /* Content */
  .popup-dialog-content {
    padding: 1.5rem 1.75rem 1.75rem;
    text-align: center;
  }

  .popup-dialog-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary, #262626);
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .popup-dialog-desc {
    font-size: 0.95rem;
    color: var(--text-secondary, #525252);
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }

  /* CTA button */
  .popup-dialog-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    background: var(--primary-blue, #0284C7);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px -4px rgba(2, 132, 199, 0.4);
  }

  .popup-dialog-cta:hover {
    background: var(--accent-blue, #0EA5E9);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -4px rgba(2, 132, 199, 0.5);
  }

  .popup-dialog-cta:active {
    transform: translateY(0);
  }

  /* Image-only mode (no title/desc) — rounded fully */
  .popup-dialog-container:not(:has(.popup-dialog-content)) .popup-dialog-image-wrap {
    border-radius: 1.25rem;
  }

  /* Body scroll lock when popup is open */
  body.popup-open {
    overflow: hidden;
  }

  /* ═══ Responsive ═══ */
  @media (max-width: 640px) {
    .popup-dialog-container {
      max-width: 92vw;
      border-radius: 1rem;
    }

    .popup-dialog-image-wrap {
      border-radius: 1rem 1rem 0 0;
    }



    .popup-dialog-content {
      padding: 1.25rem 1.25rem 1.5rem;
    }

    .popup-dialog-title {
      font-size: 1.15rem;
    }

    .popup-dialog-desc {
      font-size: 0.875rem;
    }

    .popup-dialog-close {
      width: 32px;
      height: 32px;
    }

    .popup-dialog-close svg {
      width: 16px;
      height: 16px;
    }

    .popup-dialog-container:not(:has(.popup-dialog-content)) .popup-dialog-image-wrap {
      border-radius: 1rem;
    }
  }
</style>

  <div
  id="cookieConsentBanner"
  class="hidden"
  role="dialog"
  aria-labelledby="cookieTitle"
  aria-describedby="cookieDesc"
>
  <div
    class="p-5 md:p-6 rounded-2xl shadow-2xl flex flex-col md:flex-row md:items-end justify-between gap-4 md:gap-6 border"
    style="background: var(--card-bg); border-color: var(--card-border); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
  >
    
    <div class="flex-1 flex flex-col text-left">
      <h3 id="cookieTitle" class="text-base md:text-lg font-bold tracking-tight mb-1" style="color: var(--text-primary);">
        การใช้งานคุกกี้
      </h3>
      <p id="cookieDesc" class="text-xs md:text-sm leading-relaxed" style="color: var(--text-secondary);">
        เราใช้คุกกี้เพื่อเพิ่มประสิทธิภาพ ประสบการณ์การใช้งาน และเพื่อการปรับปรุงการเข้าถึงข้อมูลให้ดียิ่งขึ้น คุณสามารถเลือกยอมรับการเก็บคุกกี้ทั้งหมด หรือเลือกยอมรับเฉพาะคุกกี้ที่จำเป็นได้
                  <a href="https://www.museumthailand.com/page/privacy-policy" class="underline transition-colors duration-200 hover:opacity-85 font-medium" style="color: var(--primary-blue);">
            นโยบายคุกกี้
          </a>
              </p>
    </div>

    
    <div class="flex flex-row items-center gap-3 self-end md:self-auto shrink-0">
      <button
        onclick="acceptNecessaryCookies()"
        class="px-5 py-2 rounded-full text-xs font-semibold cursor-pointer transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] border"
        style="background: var(--warm-tint); border-color: var(--card-border); color: var(--text-secondary);"
      >
        เฉพาะที่จำเป็น
      </button>
      <button
        onclick="acceptAllCookies()"
        class="px-5 py-2 rounded-full text-xs font-semibold cursor-pointer transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] border-0 text-white shadow-md shadow-sky-500/10 hover:shadow-lg hover:shadow-sky-500/20"
        style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-blue) 100%);"
      >
        ยอมรับทั้งหมด
      </button>
    </div>
  </div>
</div>

<style>
  #cookieConsentBanner {
    position: fixed;
    z-index: 50;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    opacity: 0;
    width: calc(100% - 2rem);
    max-width: 900px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
  }

  /* Adjust position for mobile views to prevent overlapping floating elements */
  @media (max-width: 480px) {
    #cookieConsentBanner {
      bottom: 5.5rem; /* Raised slightly higher on mobile */
      width: calc(100% - 1.5rem);
    }
  }

  #cookieConsentBanner.cookie-active {
    display: block !important;
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  #cookieConsentBanner.cookie-closing {
    transform: translateX(-50%) translateY(100px) scale(0.95);
    opacity: 0;
  }
</style>


