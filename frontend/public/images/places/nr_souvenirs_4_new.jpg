  <script src="/livewire/livewire.min.js?id=57eb113f"   data-csrf="" data-update-uri="/livewire/update" data-navigate-once="true"></script>
  <script>
    document.addEventListener('livewire:init', function() {
      if (typeof Livewire !== 'undefined') {
        Livewire.hook('request', function({ fail }) {
          fail(function({ status, preventDefault }) {
            if (status === 419) {
              preventDefault();
              window.location.href = "https://www.museumthailand.com/login";
            }
          });
        });
      }
    });
  </script>
  <script>
(function() {
  const canvas = document.getElementById('bgPatternCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let currentPattern = localStorage.getItem('bg-pattern') || 'shapes';
  let animationId = null;
  let particles = [];
  let meshNodes = [];

  // ───── Utility ─────
  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function updateButtons() {
    const btnShapes = document.getElementById('patternBtnShapes');
    const btnMesh = document.getElementById('patternBtnMesh');
    if (btnShapes) {
      btnShapes.style.background = currentPattern === 'shapes' ? 'var(--primary-blue)' : 'transparent';
      btnShapes.style.color = currentPattern === 'shapes' ? '#fff' : '#94a3b8';
    }
    if (btnMesh) {
      btnMesh.style.background = currentPattern === 'mesh' ? 'var(--primary-blue)' : 'transparent';
      btnMesh.style.color = currentPattern === 'mesh' ? '#fff' : '#94a3b8';
    }
  }

  // ───── SHAPES pattern ─────
  const shapeColors = [
    'rgba(0, 99, 151, 0.07)', 'rgba(52, 152, 219, 0.06)',
    'rgba(59, 130, 246, 0.06)', 'rgba(14, 165, 233, 0.05)',
    'rgba(6, 182, 212, 0.05)',
  ];

  function createShapeParticles() {
    const count = Math.min(Math.floor(window.innerWidth / 60), 25);
    particles = [];
    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        size: Math.random() * 30 + 15,
        speedX: (Math.random() - 0.5) * 0.3, speedY: (Math.random() - 0.5) * 0.2,
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.005,
        opacity: Math.random() * 0.5 + 0.3,
        type: Math.floor(Math.random() * 5),
        color: shapeColors[Math.floor(Math.random() * shapeColors.length)],
      });
    }
  }

  function drawDiamond(c, s) { c.beginPath(); c.moveTo(0, -s); c.lineTo(s * 0.6, 0); c.lineTo(0, s); c.lineTo(-s * 0.6, 0); c.closePath(); }
  function drawLotus(c, s) { for (let i = 0; i < 5; i++) { const a = (i * Math.PI * 2) / 5 - Math.PI / 2; c.beginPath(); c.ellipse(Math.cos(a) * s * 0.3, Math.sin(a) * s * 0.3, s * 0.5, s * 0.2, a, 0, Math.PI * 2); c.fill(); } }
  function drawTriangle(c, s) { c.beginPath(); c.moveTo(0, -s); c.lineTo(s * 0.85, s * 0.7); c.lineTo(-s * 0.85, s * 0.7); c.closePath(); }
  function drawCircleRing(c, s) { c.beginPath(); c.arc(0, 0, s, 0, Math.PI * 2); c.stroke(); c.beginPath(); c.arc(0, 0, s * 0.6, 0, Math.PI * 2); c.stroke(); }
  function drawCross(c, s) { const w = s * 0.25; c.beginPath(); c.rect(-w, -s, w * 2, s * 2); c.fill(); c.beginPath(); c.rect(-s, -w, s * 2, w * 2); c.fill(); }

  function animateShapes() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(function(p) {
      p.x += p.speedX; p.y += p.speedY; p.rotation += p.rotationSpeed;
      if (p.x < -p.size * 2) p.x = canvas.width + p.size;
      if (p.x > canvas.width + p.size * 2) p.x = -p.size;
      if (p.y < -p.size * 2) p.y = canvas.height + p.size;
      if (p.y > canvas.height + p.size * 2) p.y = -p.size;
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rotation);
      ctx.globalAlpha = p.opacity; ctx.fillStyle = p.color; ctx.strokeStyle = p.color; ctx.lineWidth = 1.5;
      switch (p.type) {
        case 0: drawDiamond(ctx, p.size); ctx.fill(); break;
        case 1: drawLotus(ctx, p.size); break;
        case 2: drawTriangle(ctx, p.size); ctx.stroke(); break;
        case 3: drawCircleRing(ctx, p.size); break;
        case 4: drawCross(ctx, p.size); break;
      }
      ctx.restore();
    });
    animationId = requestAnimationFrame(animateShapes);
  }

  // ───── MESH pattern ─────
  function createMeshNodes() {
    meshNodes = [];
    const spacing = Math.max(80, Math.min(120, window.innerWidth / 14));
    const cols = Math.ceil(canvas.width / spacing) + 2;
    const rows = Math.ceil(canvas.height / spacing) + 2;
    for (let row = -1; row < rows; row++) {
      for (let col = -1; col < cols; col++) {
        const offsetX = row % 2 === 0 ? 0 : spacing * 0.5;
        const x = col * spacing + offsetX;
        const y = row * spacing * 0.866;
        const jx = (Math.random() - 0.5) * spacing * 0.3;
        const jy = (Math.random() - 0.5) * spacing * 0.3;
        meshNodes.push({ x: x + jx, y: y + jy, ox: x + jx, oy: y + jy, vx: (Math.random() - 0.5) * 0.15, vy: (Math.random() - 0.5) * 0.15 });
      }
    }
  }

  function getBaseColor() {
    const blue = getComputedStyle(document.documentElement).getPropertyValue('--primary-blue').trim() || '#0284C7';
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(blue);
    return result ? { r: parseInt(result[1], 16), g: parseInt(result[2], 16), b: parseInt(result[3], 16) } : { r: 0, g: 99, b: 151 };
  }

  function animateMesh() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const bc = getBaseColor();
    const connDist = Math.max(100, Math.min(160, window.innerWidth / 10));

    meshNodes.forEach(function(n) {
      n.x += n.vx; n.y += n.vy;
      n.vx += (n.ox - n.x) * 0.001; n.vy += (n.oy - n.y) * 0.001;
      n.vx *= 0.998; n.vy *= 0.998;
    });

    // Edges
    ctx.lineWidth = 0.5;
    for (let i = 0; i < meshNodes.length; i++) {
      for (let j = i + 1; j < meshNodes.length; j++) {
        const d = Math.hypot(meshNodes[i].x - meshNodes[j].x, meshNodes[i].y - meshNodes[j].y);
        if (d < connDist) {
          ctx.strokeStyle = 'rgba(' + bc.r + ',' + bc.g + ',' + bc.b + ',' + ((1 - d / connDist) * 0.12) + ')';
          ctx.beginPath(); ctx.moveTo(meshNodes[i].x, meshNodes[i].y); ctx.lineTo(meshNodes[j].x, meshNodes[j].y); ctx.stroke();
        }
      }
    }

    // Triangles
    for (let i = 0; i < meshNodes.length; i++) {
      for (let j = i + 1; j < meshNodes.length; j++) {
        const dij = Math.hypot(meshNodes[i].x - meshNodes[j].x, meshNodes[i].y - meshNodes[j].y);
        if (dij > connDist) continue;
        for (let k = j + 1; k < meshNodes.length; k++) {
          const dik = Math.hypot(meshNodes[i].x - meshNodes[k].x, meshNodes[i].y - meshNodes[k].y);
          const djk = Math.hypot(meshNodes[j].x - meshNodes[k].x, meshNodes[j].y - meshNodes[k].y);
          if (dik < connDist && djk < connDist) {
            const avg = (dij + dik + djk) / 3;
            ctx.fillStyle = 'rgba(' + bc.r + ',' + bc.g + ',' + bc.b + ',' + ((1 - avg / connDist) * 0.03) + ')';
            ctx.beginPath(); ctx.moveTo(meshNodes[i].x, meshNodes[i].y); ctx.lineTo(meshNodes[j].x, meshNodes[j].y); ctx.lineTo(meshNodes[k].x, meshNodes[k].y); ctx.closePath(); ctx.fill();
          }
        }
      }
    }

    // Dots
    meshNodes.forEach(function(n) {
      ctx.fillStyle = 'rgba(' + bc.r + ',' + bc.g + ',' + bc.b + ',0.15)';
      ctx.beginPath(); ctx.arc(n.x, n.y, 1.5, 0, Math.PI * 2); ctx.fill();
    });

    animationId = requestAnimationFrame(animateMesh);
  }

  // ───── Start / switch ─────
  function startPattern() {
    if (animationId) cancelAnimationFrame(animationId);
    resize();
    if (currentPattern === 'shapes') {
      createShapeParticles();
      animateShapes();
    } else {
      createMeshNodes();
      animateMesh();
    }
    updateButtons();
  }

  window.setBgPattern = function(type) {
    currentPattern = type;
    localStorage.setItem('bg-pattern', type);
    startPattern();
  };

  startPattern();
  window.addEventListener('resize', function() { resize(); if (currentPattern === 'shapes') createShapeParticles(); else createMeshNodes(); });
})();
</script>
<script>
(function() {
  // ===== A11Y STATE =====
  const A11Y_CLASSES = {
    fontScale:      ['', 'a11y-font-scale-1', 'a11y-font-scale-2'],
    letterSpacing:  ['', 'a11y-letter-spacing-1', 'a11y-letter-spacing-2'],
  };

  const A11Y_TOGGLES = {
    largeCursor:    'a11y-large-cursor',
    readingGuide:   'a11y-reading-guide',
    highlightLinks: 'a11y-highlight-links',
    colorAdjust:    'a11y-color-adjust',
  };

  // Load saved state
  let state = {};
  try {
    state = JSON.parse(localStorage.getItem('museumA11y') || '{}');
  } catch(e) {}

  // Defaults
  if (typeof state.fontScale !== 'number') state.fontScale = 0;
  if (typeof state.letterSpacing !== 'number') state.letterSpacing = 0;
  Object.keys(A11Y_TOGGLES).forEach(k => {
    if (typeof state[k] !== 'boolean') state[k] = false;
  });

  function saveState() {
    localStorage.setItem('museumA11y', JSON.stringify(state));
  }

  function applyState() {
    const html = document.documentElement;

    // Multi-level: fontScale
    A11Y_CLASSES.fontScale.forEach(c => { if(c) html.classList.remove(c); });
    if (state.fontScale > 0) html.classList.add(A11Y_CLASSES.fontScale[state.fontScale]);

    // Multi-level: letterSpacing
    A11Y_CLASSES.letterSpacing.forEach(c => { if(c) html.classList.remove(c); });
    if (state.letterSpacing > 0) html.classList.add(A11Y_CLASSES.letterSpacing[state.letterSpacing]);

    // Toggles
    Object.entries(A11Y_TOGGLES).forEach(([key, cls]) => {
      html.classList.toggle(cls, !!state[key]);
    });

    // Reading guide
    const guide = document.getElementById('readingGuide');
    if (guide) guide.style.display = state.readingGuide ? 'block' : 'none';

    // Update UI
    updateUI();
    saveState();
  }

  function updateUI() {
    // Multi-level indicators
    ['fontScale', 'letterSpacing'].forEach(key => {
      const container = document.getElementById('a11y' + capitalize(key) + 'Levels');
      const card = document.getElementById('a11y' + capitalize(key) + 'Card');
      if (container) {
        container.querySelectorAll('.a11y-level-num').forEach(el => {
          const idx = parseInt(el.dataset.idx);
          el.classList.toggle('a11y-level-num--active', idx === state[key]);
        });
      }
      if (card) card.classList.toggle('a11y-feature-card--active', state[key] > 0);
    });

    // Toggle checkmarks
    Object.keys(A11Y_TOGGLES).forEach(key => {
      const check = document.getElementById('a11y' + capitalize(key) + 'Check');
      const card = document.getElementById('a11y' + capitalize(key) + 'Card');
      if (check) {
        const icon = check.querySelector('i');
        if (icon) {
          icon.style.color = state[key] ? '#14918B' : 'rgba(255,255,255,0.2)';
        }
      }
      if (card) card.classList.toggle('a11y-feature-card--active', !!state[key]);
    });
  }

  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  // Public API
  window.cycleA11yLevel = function(key) {
    const max = A11Y_CLASSES[key].length - 1;
    state[key] = (state[key] + 1) % (max + 1);
    applyState();
  };

  window.toggleA11yFeature = function(key) {
    state[key] = !state[key];
    applyState();
  };

  window.enableAllA11y = function() {
    state.fontScale = 1;
    state.letterSpacing = 1;
    Object.keys(A11Y_TOGGLES).forEach(k => state[k] = true);
    applyState();
  };

  window.disableAllA11y = function() {
    state.fontScale = 0;
    state.letterSpacing = 0;
    Object.keys(A11Y_TOGGLES).forEach(k => state[k] = false);
    applyState();
  };

  window.closeA11yPanel = function() {
    const panel = document.getElementById('a11yPanel');
    const overlay = document.getElementById('a11yOverlay');
    if (panel) panel.classList.remove('a11y-panel--open');
    if (overlay) overlay.classList.remove('a11y-panel__overlay--visible');
    document.body.style.overflow = '';
  };

  // Reading guide follows mouse
  document.addEventListener('mousemove', function(e) {
    const guide = document.getElementById('readingGuide');
    if (guide && state.readingGuide) {
      guide.style.top = e.clientY + 'px';
    }
  });

  // Init on load
  applyState();
})();
</script>
<script>
(function() {
  // ===== DARK MODE TOGGLE =====
  function isDarkMode() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function updateLogo() {
    const dark = isDarkMode();
    document.querySelectorAll('.nav-logo--light').forEach(el => el.style.display = dark ? 'none' : '');
    document.querySelectorAll('.nav-logo--dark').forEach(el => el.style.display = dark ? '' : 'none');
  }

  function updateDarkModeUI() {
    const sunIcon = document.getElementById('darkModeIconSun');
    const moonIcon = document.getElementById('darkModeIconMoon');
    const btn = document.getElementById('darkModeToggleBtn');

    if (isDarkMode()) {
      if (sunIcon) { sunIcon.style.opacity = '1'; sunIcon.style.transform = 'rotate(0deg) scale(1)'; }
      if (moonIcon) { moonIcon.style.opacity = '0'; moonIcon.style.transform = 'rotate(90deg) scale(0.5)'; }
      if (btn) btn.title = 'Switch to light mode';
    } else {
      if (moonIcon) { moonIcon.style.opacity = '1'; moonIcon.style.transform = 'rotate(0deg) scale(1)'; }
      if (sunIcon) { sunIcon.style.opacity = '0'; sunIcon.style.transform = 'rotate(-90deg) scale(0.5)'; }
      if (btn) btn.title = 'Switch to dark mode';
    }

    updateLogo();
  }

  window.toggleDarkMode = function() {
    const newDark = !isDarkMode();
    if (newDark) {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('museum-dark-mode', String(newDark));
    updateDarkModeUI();

    // Update loading screen background if still present
    var ls = document.getElementById('loadingScreen');
    if (ls) ls.style.background = newDark ? '#121212' : '#F7F7F5';
  };

  // Init
  updateDarkModeUI();
})();
</script>
<script>
(function() {
  var popup = document.getElementById('popupDialog');
  if (!popup) return;

  var frequency = popup.getAttribute('data-frequency') || 'once_per_session';
  var storageKey = 'museum-popup-dismissed';

  // Check if popup should be shown based on frequency
  function shouldShowPopup() {
    if (frequency === 'every_time') return true;

    if (frequency === 'once_per_session') {
      return sessionStorage.getItem(storageKey) !== '1';
    }

    if (frequency === 'once_per_day') {
      var lastDismissed = localStorage.getItem(storageKey);
      if (!lastDismissed) return true;
      var today = new Date().toDateString();
      return lastDismissed !== today;
    }

    return true;
  }

  // Mark popup as dismissed
  function markDismissed() {
    if (frequency === 'once_per_session') {
      sessionStorage.setItem(storageKey, '1');
    } else if (frequency === 'once_per_day') {
      localStorage.setItem(storageKey, new Date().toDateString());
    }
  }

  // Close popup
  window.closePopupDialog = function() {
    popup.classList.remove('popup-active');
    popup.classList.add('popup-closing');
    document.body.classList.remove('popup-open');
    markDismissed();
    setTimeout(function() {
      popup.style.display = 'none';
      popup.classList.remove('popup-closing');
    }, 300);
  };

  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && popup.style.display !== 'none') {
      closePopupDialog();
    }
  });

  // Show popup after a brief delay (let page settle)
  if (shouldShowPopup()) {
    setTimeout(function() {
      popup.style.display = 'flex';
      document.body.classList.add('popup-open');
      // Trigger animation on next frame
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          popup.classList.add('popup-active');
        });
      });
    }, 800);
  }
})();
</script>
<script>
(function() {
  const CONSENT_KEY = 'museum-cookie-consent';

  // Support resetting cookie consent via URL parameter (e.g. ?reset-cookie=1 or ?cookie-test=1)
  if (window.location.search.includes('reset-cookie=1') || window.location.search.includes('cookie-test=1')) {
    localStorage.removeItem(CONSENT_KEY);
    console.log('Cookie consent reset triggered via URL parameter.');
  }

  console.log('Cookie consent script loaded. Consent state:', localStorage.getItem(CONSENT_KEY));

  window.showCookieBanner = function() {
    const banner = document.getElementById('cookieConsentBanner');
    if (!banner) {
      console.warn('Cookie consent banner element not found in DOM.');
      return;
    }
    console.log('Showing cookie consent banner...');
    banner.classList.remove('hidden');
    // Force reflow
    banner.offsetHeight;
    banner.classList.add('cookie-active');
  };

  window.closeCookieBanner = function(consentType) {
    const banner = document.getElementById('cookieConsentBanner');
    if (!banner) return;
    console.log('Closing cookie consent banner. Choice:', consentType);
    banner.classList.add('cookie-closing');
    localStorage.setItem(CONSENT_KEY, consentType);
    
    // Smooth transition cleanup
    setTimeout(function() {
      banner.classList.remove('cookie-active', 'cookie-closing');
      banner.classList.add('hidden');
    }, 600);
  };

  window.acceptAllCookies = function() {
    closeCookieBanner('all');
  };

  window.acceptNecessaryCookies = function() {
    closeCookieBanner('necessary');
  };

  // Run initialization logic as soon as DOM is interactive
  function initCookieConsent() {
    if (!localStorage.getItem(CONSENT_KEY)) {
      console.log('No prior consent found. Scheduling banner display...');
      setTimeout(showCookieBanner, 1000);
    } else {
      console.log('Prior cookie consent choice found: ' + localStorage.getItem(CONSENT_KEY));
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initCookieConsent();
  } else {
    document.addEventListener('DOMContentLoaded', initCookieConsent);
  }
})();
</script>
  
  <style>
    /* Push Chatbase widget to the left of the dark mode toggle */
    #chatbase-bubble-button { display: none !important; }
    #chatbase-bubble-window { display: none !important; }
  </style>
  
</body>
</html>
